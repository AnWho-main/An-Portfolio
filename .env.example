# Portfolio Contact Email Configuration
# Choose one of the options below and put it in your .env.local file:

# Option 1: Resend (Recommended - get key from https://resend.com)
RESEND_API_KEY= key
RESEND_FROM_EMAIL="My Portfolio <onboarding@resend.dev>"

# Option 2: Gmail SMTP (Get App Password from Google Account > Security > App Passwords)
# GMAIL_USER=anshuman357main@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
